---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import MetricsBand from '../components/MetricsBand.astro';
import SectionAbout from '../components/SectionAbout.astro';
import SectionCases from '../components/SectionCases.astro';
import SectionExperience from '../components/SectionExperience.astro';
import SectionSystems from '../components/SectionSystems.astro';
import SectionDiscovery from '../components/SectionDiscovery.astro';
import SectionBuilds from '../components/SectionBuilds.astro';
import SectionThinking from '../components/SectionThinking.astro';
import SectionEngagements from '../components/SectionEngagements.astro';
import SectionRecognition from '../components/SectionRecognition.astro';
import SectionContact from '../components/SectionContact.astro';
