---
import { Image } from 'astro:assets';

export interface Shot {
  src: ImageMetadata;
  alt: string;
  label: string;
  caption: string;
}

interface Props {
  id: string;
  title: string;
  shots: Shot[];
}

const { id, title, shots } = Astro.props;
---

<div class="mx-auto w-full max-w-[240px] md:max-w-none" data-gallery>
  <!-- Screens: one visible at a time, in a fixed-ratio box so nothing shifts -->
  <div
    class="relative aspect-[860/1864] touch-pan-y overflow-hidden rounded-[1.75rem] border hairline"
    data-gallery-viewport
  >
    {
      shots.map((shot, i) => (
        <div
          class="gallery-panel absolute inset-0"
          role="tabpanel"
          id={`${id}-panel-${i}`}
          aria-labelledby={`${id}-tab-${i}`}
          aria-hidden={i === 0 ? 'false' : 'true'}
          data-active={i === 0 ? '' : null}
        >
          <Image
            src={shot.src}
            alt={shot.alt}
            widths={[240, 280, 560, 840]}
            sizes="(min-width: 768px) 280px, 240px"
            class="h-full w-full object-cover object-top"
            loading="lazy"
          />
        </div>
      ))
    }
  </div>

  <!-- Controls: segmented, doubling as the label of each screen -->
  <div class="mt-4 flex gap-2" role="tablist" aria-label={`${title} screens`}>
    {
      shots.map((shot, i) => (
        <button
          class="gallery-tab numeric flex-1 border-t pt-2 text-left text-[10px] font-medium uppercase tracking-[0.14em]"
          type="button"
          role="tab"
          id={`${id}-tab-${i}`}
          aria-controls={`${id}-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-caption={shot.caption}
        >
          {shot.label}
        </button>
      ))
    }
  </div>

  <p
    class="mt-3 text-xs leading-relaxed text-[color:var(--color-muted)]"
    data-gallery-caption
    aria-live="polite"
  >
    {shots[0].caption}
  </p>
</div>

<style>
  .gallery-panel {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 250ms ease,
      visibility 250ms ease;
  }

  .gallery-panel[data-active] {
    opacity: 1;
    visibility: visible;
  }

  .gallery-tab {
    border-top-color: var(--color-hairline);
    color: var(--color-muted);
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .gallery-tab:hover {
    color: var(--color-ink);
  }

  .gallery-tab[aria-selected='true'] {
    border-top-color: var(--color-accent);
    color: var(--color-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-panel {
      transition: none;
    }
  }
</style>

<script>
  const AUTOPLAY_MS = 3000;
  const SWIPE_THRESHOLD_PX = 40;

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const tabs = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(gallery.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const caption = gallery.querySelector<HTMLElement>('[data-gallery-caption]');
    const viewport = gallery.querySelector<HTMLElement>('[data-gallery-viewport]');
    if (tabs.length < 2 || !viewport) return;

    let current = 0;
    // Autoplay pauses while any of these is true; a mouse hover, a keyboard
    // focus inside the gallery, an in-progress touch, or being off-screen.
    let hovered = false;
    let focused = false;
    let touching = false;
    let intersecting = false;

    const select = (index: number, { moveFocus = false, auto = false } = {}) => {
      current = index;

      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel, i) => {
        const active = i === index;
        panel.toggleAttribute('data-active', active);
        panel.setAttribute('aria-hidden', String(!active));
      });

      if (caption) {
        // Autoplay shouldn't spam a screen reader every 3s; manual moves still announce.
        caption.setAttribute('aria-live', auto ? 'off' : 'polite');
        caption.textContent = tabs[index].dataset.caption ?? '';
      }
      if (moveFocus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));

      tab.addEventListener('keydown', (event) => {
        const last = tabs.length - 1;
        let next: number | null = null;

        if (event.key === 'ArrowRight') next = i === last ? 0 : i + 1;
        else if (event.key === 'ArrowLeft') next = i === 0 ? last : i - 1;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = last;

        if (next !== null) {
          event.preventDefault();
          select(next, { moveFocus: true });
        }
      });
    });

    // Swipe: touch-action: pan-y (in the markup) already tells the browser to
    // leave horizontal gestures to us, so no preventDefault dance is needed.
    let touchStartX: number | null = null;
    let touchStartY: number | null = null;

    viewport.addEventListener(
      'touchstart',
      (event) => {
        const t = event.changedTouches[0];
        touchStartX = t.clientX;
        touchStartY = t.clientY;
        touching = true;
      },
      { passive: true },
    );

    const endTouch = (event: TouchEvent) => {
      if (touchStartX !== null && touchStartY !== null) {
        const t = event.changedTouches[0];
        const dx = t.clientX - touchStartX;
        const dy = t.clientY - touchStartY;
        if (Math.abs(dx) > SWIPE_THRESHOLD_PX && Math.abs(dx) > Math.abs(dy)) {
          const dir = dx < 0 ? 1 : -1;
          select((current + dir + tabs.length) % tabs.length);
        }
      }
      touchStartX = null;
      touchStartY = null;
      touching = false;
    };

    viewport.addEventListener('touchend', endTouch);
    viewport.addEventListener('touchcancel', endTouch);

    // Autoplay: a single recurring tick that just no-ops while paused, rather
    // than juggling separate timers per pause reason.
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    gallery.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') hovered = true;
    });
    gallery.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') hovered = false;
    });
    gallery.addEventListener('focusin', () => (focused = true));
    gallery.addEventListener('focusout', () => (focused = false));

    new IntersectionObserver(([entry]) => (intersecting = entry.isIntersecting), {
      threshold: 0.4,
    }).observe(gallery);

    if (!prefersReducedMotion) {
      setInterval(() => {
        if (hovered || focused || touching || !intersecting) return;
        if (document.visibilityState !== 'visible') return;
        select((current + 1) % tabs.length, { auto: true });
      }, AUTOPLAY_MS);
    }
  });
</script>
