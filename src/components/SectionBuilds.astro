---
import BuildGallery from './BuildGallery.astro';
import type { Shot } from './BuildGallery.astro';

import handoverboatWalk from '../assets/screenshots/handoverboat/walk_full_boat.png';
import handoverboatStart from '../assets/screenshots/handoverboat/start_protect_deposit.png';
import handoverboatList from '../assets/screenshots/handoverboat/list_inspections.png';
import mangaltimeHome from '../assets/screenshots/mangaltime/home_first_try.png';
import mangaltimeMeat from '../assets/screenshots/mangaltime/meat_parameters.png';
import mangaltimeTimer from '../assets/screenshots/mangaltime/timer_flip_cue.png';
import artpawHome from '../assets/screenshots/artpaw/home.png';
import artpawProduct from '../assets/screenshots/artpaw/product.png';

const handoverboatShots: Shot[] = [
  {
    src: handoverboatWalk,
    alt: "HandoverBoat — guided inspection walk showing a full sailboat illustration with photo-capture points across sixteen zones",
    label: 'Walk',
    caption: 'Sixteen zones on one boat illustration, each a photo-capture point.',
  },
  {
    src: handoverboatStart,
    alt: "HandoverBoat — start screen with the rental setup form and the headline 'Protect your deposit. Document the boat.'",
    label: 'Start',
    caption: 'Rental setup before the handover — the deposit is what is at stake.',
  },
  {
    src: handoverboatList,
    alt: 'HandoverBoat — inspections dashboard listing every boat handover, searchable across seasons and available offline',
    label: 'Records',
    caption: 'Every handover, searchable across seasons and available offline.',
  },
];

const mangaltimeShots: Shot[] = [
  {
    src: mangaltimeHome,
    alt: "Mangal Time — home screen with the headline 'Juicy shashlyk on the first try' and a three-step flow, RU/EN/PL language toggle",
    label: 'Home',
    caption: 'Three steps to the first skewer, in RU / EN / PL.',
  },
  {
    src: mangaltimeMeat,
    alt: "Mangal Time — 'Pick your meat' setup: meat type, cut, skewer count, chunk size and uniformity as structured inputs",
    label: 'Setup',
    caption: "A grillmaster's tacit knowledge as structured inputs: cut, size, uniformity.",
  },
  {
    src: mangaltimeTimer,
    alt: "Mangal Time — live grilling timer with a 'Time to flip!' cue and a skewer illustration",
    label: 'Timer',
    caption: 'One glanceable cue for dirty hands and bright sun: time to flip.',
  },
];

const artpawShots: Shot[] = [
  {
    src: artpawHome,
    alt: "ArtPaw — storefront hero: 'Your Pet, Painted Like Royalty' with a gallery of framed renaissance pet portraits",
    label: 'Storefront',
    caption: 'The hook: your pet, painted like royalty, framed and shipped across the EU.',
  },
  {
    src: artpawProduct,
    alt: "ArtPaw — product page for 'The General — Royal Pet Portrait' showing price, sale, tax-included note, and format options",
    label: 'Product',
    caption: 'Formats, price, EU tax included — a real checkout, not a mockup.',
  },
];
---

<section id="builds" class="mx-auto max-w-5xl scroll-mt-16 px-6 py-24 md:py-32">
  <div class="mx-auto max-w-3xl">
    <p class="mb-6 text-xs font-medium uppercase tracking-[0.2em] text-[color:var(--color-muted)] numeric">
      08 · Personal builds
    </p>
    <p class="mb-16 text-lg leading-relaxed text-[color:var(--color-ink)] md:text-xl">
      I ship products under my own name, not just under a job title. Three live,
      several in the pipeline.
    </p>
  </div>

  <div class="space-y-20 md:space-y-28">

    <!-- HandoverBoat -->
    <article class="grid gap-10 md:grid-cols-[1fr_280px] md:items-center md:gap-14">
      <div class="order-2 md:order-1">
        <h3 class="mb-2 text-2xl font-bold tracking-tight text-[color:var(--color-ink)] md:text-3xl">
          HandoverBoat
        </h3>
        <p class="mb-6 text-sm text-[color:var(--color-muted)]">
          <a href="https://handoverboat.com" class="text-[color:var(--color-accent)] hover:underline">
            handoverboat.com
          </a>
          · charter deposit protection · flagship
        </p>
        <div class="space-y-5 text-base leading-relaxed text-[color:var(--color-ink)] md:text-lg">
          <p>
            A charter deposit protection platform for yacht and boat rentals.
            Before you sail: photograph the boat's condition with GPS-timestamped,
            RFC 3161–qualified evidence. When you return: a matching inspection
            produces a before/after PDF the operator and the charterer both sign
            against. A public verify endpoint lets anyone independently confirm
            the record wasn't edited.
          </p>
          <p>
            Built solo, top to bottom: system architecture, Next.js 15 + Supabase +
            Stripe stack, UI/UX, illustrations, product design, legal review across
            HR/EL/IT/PL jurisdictions, copy, SEO, launch. Deployed on Vercel. Eight
            languages live at launch.
          </p>
          <p class="text-[color:var(--color-muted)]">
            Positioning: an independent evidence record with a reversal of the
            burden of proof — not a «you-signed-so-you-accepted» acceptance engine.
          </p>
        </div>
      </div>
      <div class="order-1 md:order-2">
        <BuildGallery id="handoverboat" title="HandoverBoat" shots={handoverboatShots} />
      </div>
    </article>

    <!-- Mangal Time -->
    <article class="grid gap-10 md:grid-cols-[280px_1fr] md:items-center md:gap-14">
      <BuildGallery id="mangaltime" title="Mangal Time" shots={mangaltimeShots} />
      <div>
        <h3 class="mb-2 text-2xl font-bold tracking-tight text-[color:var(--color-ink)] md:text-3xl">
          Mangal Time
        </h3>
        <p class="mb-6 text-sm text-[color:var(--color-muted)]">
          <a href="https://mangal-time.shop" class="text-[color:var(--color-accent)] hover:underline">
            mangal-time.shop
          </a>
          · consumer app, multilingual, live in production
        </p>
        <div class="space-y-5 text-base leading-relaxed text-[color:var(--color-ink)] md:text-lg">
          <p>
            A shashlyk grilling timer and assistant. The interesting product decision:
            the UX is designed around the operator's real conditions — dirty hands,
            bright sun, awkward posture, split attention. Every touch target, every
            timer trigger, every glanceable state is tuned for that context, not for
            a comfortable office demo.
          </p>
          <p>
            The domain runs deeper than a timer. Meat type and cut, coal stage,
            open-flame behavior, fuel type, height above coals, skewer count — a
            grillmaster's tacit knowledge translated into structured inputs.
            Multilingual from launch across RU / EN / PL, illustrated in-house,
            adapted for the moment of use, not the moment of a design review.
          </p>
          <p class="text-[color:var(--color-muted)]">
            Built for friends; open to the world.
          </p>
        </div>
      </div>
    </article>

    <!-- ArtPaw -->
    <article class="grid gap-10 md:grid-cols-[1fr_280px] md:items-center md:gap-14">
      <div class="order-2 md:order-1">
        <h3 class="mb-2 text-2xl font-bold tracking-tight text-[color:var(--color-ink)] md:text-3xl">
          ArtPaw
        </h3>
        <p class="mb-6 text-sm text-[color:var(--color-muted)]">
          <a href="https://artpaw.shop" class="text-[color:var(--color-accent)] hover:underline">
            artpaw.shop
          </a>
          · live e-commerce · real orders across the EU
        </p>
        <div class="space-y-5 text-base leading-relaxed text-[color:var(--color-ink)] md:text-lg">
          <p>
            Renaissance-style pet portraits — your dog or cat composed in the light
            of the old masters, printed, framed, and delivered across Europe. A full
            Shopify storefront: catalogue, variants, checkout, EU shipping and tax,
            and every policy page.
          </p>
          <p>
            I built the whole thing — brand, copy, imagery, and store — 100% by
            AI-assisted coding, originally as an attribution testbed for my day job.
            Then it started taking real orders.
          </p>
          <p class="text-[color:var(--color-muted)]">
            The point it proves: vibe-coding reaches all the way to a transacting
            business, not just a prototype.
          </p>
        </div>
      </div>
      <div class="order-1 md:order-2">
        <BuildGallery id="artpaw" title="ArtPaw" shots={artpawShots} />
      </div>
    </article>

  </div>
</section>
