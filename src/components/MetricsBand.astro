---
const metrics = [
  { value: '25+', label: 'agents in production' },
  { value: '$2.3M', label: 'smart-contract volume · Roketo' },
  { value: '33 → 75%', label: 'onboarding completion · FemFast' },
  { value: '16', label: 'cross-functional team · Crypto NeoBank' },
];
---

<section class="border-y hairline">
  <div class="mx-auto grid max-w-5xl grid-cols-2 gap-8 px-6 py-10 md:grid-cols-4 md:py-12">
    {
      metrics.map(({ value, label }) => (
        <div>
          <div class="numeric text-2xl font-semibold text-[color:var(--color-accent)] md:text-3xl">
            {value}
          </div>
          <div class="mt-2 text-xs leading-snug text-[color:var(--color-muted)] md:text-sm">
            {label}
          </div>
        </div>
      ))
    }
  </div>
</section>
