---
const links = [
  { href: '#now', label: 'Now' },
  { href: '#cases', label: 'Cases' },
  { href: '#systems', label: 'Systems' },
  { href: '#discovery', label: 'Discovery' },
  { href: '#builds', label: 'Builds' },
  { href: '#thinking', label: 'Thinking' },
  { href: '#engagements', label: 'Engagements' },
  { href: '#contact', label: 'Contact' },
];
---

<nav class="sticky top-0 z-40 border-b hairline bg-[color:var(--color-cream)]/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center gap-5 px-6 py-4">
    <a href="/" class="shrink-0 text-sm font-semibold tracking-tight text-[color:var(--color-ink)]">
      Vlad Derkach
    </a>
    <!--
      The six section links don't fit next to the name on a phone. They scroll
      sideways inside the bar rather than stretching the page, so nothing is
      hidden and the page itself never scrolls horizontally.
    -->
    <div class="nav-links min-w-0 flex-1 overflow-x-auto md:overflow-x-visible">
      <ul
        class="flex items-center gap-5 whitespace-nowrap text-sm text-[color:var(--color-muted)] md:justify-end md:gap-6"
      >
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="transition-colors hover:text-[color:var(--color-accent)]"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</nav>

<style>
  .nav-links {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .nav-links::-webkit-scrollbar {
    display: none;
  }
</style>
