---
interface Props {
  /** App name — used only for the accessible label of each store link. */
  appName: string;
  playUrl?: string;
  appStoreUrl?: string;
  /** A non-clickable App Store plaque, for an app still waiting on review. */
  appStoreSoon?: boolean;
  class?: string;
}

const {
  appName,
  playUrl,
  appStoreUrl,
  appStoreSoon = false,
  class: className = '',
} = Astro.props;

const chip =
  'inline-flex items-center gap-2 rounded-sm border hairline px-3.5 py-2 text-xs font-medium';
const linkChip = `${chip} text-[color:var(--color-ink)] transition-colors hover:border-[color:var(--color-accent)] hover:text-[color:var(--color-accent)]`;
const soonChip = `${chip} border-dashed text-[color:var(--color-muted)]`;
---

<ul class:list={['flex flex-wrap items-center gap-2.5', className]}>
  {
    playUrl && (
      <li>
        <a
          href={playUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={linkChip}
          aria-label={`${appName} on Google Play — opens in a new tab`}
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
            <path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-1.063-.166l11.157 10.96zm0 2.067L2.404 24.132c.328.038.672-.029.991-.213l13.378-7.62-3.229-3.243z" />
          </svg>
          Google Play
        </a>
      </li>
    )
  }

  {
    appStoreUrl && (
      <li>
        <a
          href={appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={linkChip}
          aria-label={`${appName} on the App Store — opens in a new tab`}
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
          </svg>
          App Store
        </a>
      </li>
    )
  }

  {
    appStoreSoon && !appStoreUrl && (
      <li>
        <span class={soonChip}>
          <svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
          </svg>
          App Store
          <span class="text-[10px] uppercase tracking-[0.14em]">coming soon</span>
        </span>
      </li>
    )
  }
</ul>
