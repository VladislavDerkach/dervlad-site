---
const experience = [
  {
    company: 'RedTrack.io',
    role: 'Product Discovery Lead & AI Champion',
    // Only this row carries a scope line — the title alone doesn't say that the
    // job is AI product operations.
    scope: 'AI product operations · 25+ agents in production',
    dates: 'Nov 2025 – Sep 2026',
  },
  { company: 'Zorka.Agency (FemFast)', role: 'Product Lead', dates: 'Mar 2025 – Nov 2025' },
  { company: 'ERA Wallet (ex-1inch)', role: 'Senior Product Manager', dates: 'Sep 2024 – Mar 2025' },
  { company: 'Crypto NeoBank (NDA)', role: 'Product Lead', dates: 'Aug 2023 – Aug 2024' },
  { company: 'Roketo', role: 'Chief Product Officer → Product Manager', dates: 'May 2022 – Aug 2023' },
  { company: 'NOWPayments', role: 'Product Manager', dates: 'May 2021 – May 2022' },
  { company: 'ChangeNOW.io', role: 'Product Consultant', dates: 'May 2021 – Sep 2021' },
  { company: 'Belkasoft', role: 'BizDev / Product Development Manager', dates: 'Oct 2017 – Mar 2021' },
  { company: 'Smart Policy', role: 'Business Development Manager', dates: 'Nov 2016 – Oct 2017' },
  { company: 'Labs Publicity Group', role: 'Production Manager', dates: 'Jul 2014 – Nov 2016' },
  { company: 'Bank «Reshenie»', role: 'Senior Legal Counsel → Legal Counsel', dates: 'Aug 2012 – Jul 2014' },
];
---

<section id="experience" class="mx-auto max-w-3xl scroll-mt-16 px-6 py-24 md:py-32">
  <p class="mb-10 text-xs font-medium uppercase tracking-[0.2em] text-[color:var(--color-muted)] numeric">
    04 · Experience
  </p>
  <p class="mb-10 text-lg leading-relaxed text-[color:var(--color-ink)]">
    Eleven companies, four industries — five years of it as a product manager.
    Details on
    <a href="https://www.linkedin.com/in/vladislavderkach/" class="text-[color:var(--color-accent)] hover:underline">LinkedIn</a>.
  </p>
  <ul class="divide-y hairline border-t border-b hairline">
    {
      experience.map(({ company, role, scope, dates }) => (
        <li class="grid gap-1 py-4 md:grid-cols-[1fr_auto] md:items-baseline md:gap-6 md:py-5">
          <div>
            <div class="text-base font-semibold tracking-tight text-[color:var(--color-ink)]">
              {company}
            </div>
            <div class="text-sm text-[color:var(--color-muted)]">{role}</div>
            {scope && (
              <div class="mt-0.5 text-sm text-[color:var(--color-accent)]">{scope}</div>
            )}
          </div>
          <div class="text-sm text-[color:var(--color-muted)] numeric md:text-right">
            {dates}
          </div>
        </li>
      ))
    }
  </ul>
</section>
